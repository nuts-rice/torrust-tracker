# Delegates to the torrust-git-hooks Rust binary. All hook output is NDJSON on stderr;
# pass/fail is the binary's exit code.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

for profile in release debug; do
    binary="${repo_root}/target/${profile}/torrust-git-hooks"
    if [[ -x "${binary}" ]]; then
        exec "${binary}" pre-commit --verbosity=concise
    fi
done

cat >&2 <<'EOF'
